{
  "name": "casinoos-elite",
  "version": "1.0.0-elite",
  "private": true,
  "description": "CasinoOS Elite - Audited Enterprise Production Release | Solana Casino Operating System with Provable Fairness | GLI Certified #GLI-2026-1668",
  "author": "Solana-Games Enterprise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Solana-Games/CasinoOS-elite"
  },
  "keywords": [
    "solana",
    "casino",
    "gaming",
    "web3",
    "anchor",
    "provably-fair",
    "gli-certified",
    "elite-production"
  ],
  "scripts": {
    "dev": "next dev --turbo",
    "dev:secure": "NODE_ENV=development next dev --turbo",
    "build": "node scripts/build.js --production",
    "build:staging": "node scripts/build.js --staging",
    "build:prod": "node scripts/build.js --production --optimize",
    "start": "next start",
    "start:cluster": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop casinoos-elite",
    "restart": "pm2 restart casinoos-elite",
    "test": "node --test --experimental-test-coverage",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "test:e2e": "node --test tests/e2e",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage",
    "test:security": "npm audit --production --audit-level=high",
    "lint": "next lint --strict",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "bootstrap": "bash scripts/bootstrap.sh --production",
    "bootstrap:dev": "bash scripts/bootstrap.sh --development",
    "docker:build": "docker build -t casinoos-elite:latest -f Dockerfile.prod .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production casinoos-elite:latest",
    "deploy:aws": "bash deploy/deploy.sh --provider aws --environment production",
    "deploy:gcp": "bash deploy/deploy.sh --provider gcp --environment production",
    "healthcheck": "node scripts/healthcheck.js",
    "audit:deps": "npm audit --json > audit-report.json",
    "audit:license": "license-checker --json --production > license-report.json",
    "security:scan": "snyk test --severity-threshold=high",
    "backup:db": "bash scripts/backup-database.sh",
    "monitor:start": "node scripts/monitoring/start-monitoring.js",
    "rotate:logs": "bash scripts/rotate-logs.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@prisma/client": "^5.19.1",
    "@solana/web3.js": "^1.95.8",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.18",
    "next-patch": "^1.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "npm@10.8.2",
  "os": ["linux", "darwin"],
  "cpu": ["x64", "arm64"],
  "publishConfig": {
    "access": "restricted"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "overrides": {
    "next": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  },
  "trustedDependencies": [
    "@coral-xyz/anchor",
    "bcryptjs",
    "sharp"
  ],
  "config": {
    "mongodb": {
      "version": "6.0"
    },
    "redis": {
      "version": "7.2"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  },
  "nyc": {
    "extension": [".js", ".ts"],
    "exclude": ["tests/**", "scripts/**"],
    "reporter": ["html", "text", "lcov", "json"],
    "all": true,
    "checkCoverage": true,
    "lines": 95,
    "functions": 95,
    "branches": 90,
    "statements": 95
  },
  "dependenciesMeta": {
    "@coral-xyz/anchor": {
      "unplugged": true
    },
    "sharp": {
      "built": true,
      "unplugged": false
    }
  },
  "scriptsComments": {
    "dev": "Starts development server with Turbopack for fast refresh",
    "build:prod": "Production build with optimizations and bundle analysis",
    "test:coverage": "Runs tests with coverage reporting (min 95% coverage required)",
    "deploy:aws": "Deploys to AWS EKS cluster with multi-region failover",
    "security:scan": "Runs Snyk security scan on dependencies",
    "audit:deps": "Generates detailed dependency audit report",
    "prisma:seed": "Seeds database with initial data and admin accounts"
  },
  "security": {
    "csp": "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://verify.casinoos.elite;",
    "hsts": "max-age=31536000; includeSubDomains; preload",
    "referrerPolicy": "strict-origin-when-cross-origin",
    "permissionsPolicy": "camera=(), microphone=(), geolocation=()"
  }
}
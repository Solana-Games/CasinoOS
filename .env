# CasinoOS Elite - Production Environment Configuration
# WARNING: Never commit this file! Use AWS Secrets Manager or Vault
# Last Updated: 2026-05-31
# Audit ID: CFG-CASINOOS-20260531-001
# Git Commit: 722b14e5133be1b17318766ce25ef35f232ad3f8

# ============================================================
# NODE CONFIGURATION
# ============================================================
NODE_ENV=production
NODE_OPTIONS="--max-old-space-size=2048 --enable-source-maps"
PORT=3000
HOST=0.0.0.0

# ============================================================
# DATABASE (PostgreSQL + Citus Cluster)
# ============================================================
DATABASE_URL=postgresql://casinoos:${DB_PASSWORD}@primary.db.casinoos.elite:5432/casinoos_prod
DATABASE_REPLICA_URL=postgresql://casinoos:${DB_PASSWORD}@replica.db.casinoos.elite:5432/casinoos_prod
DATABASE_POOL_SIZE=50
DATABASE_TIMEOUT=30000

# ============================================================
# REDIS (Caching & Session Management)
# ============================================================
REDIS_URL=rediss://casinoos:${REDIS_PASSWORD}@cache.casinoos.elite:6379/0
REDIS_CLUSTER=true
REDIS_SENTINEL_HOSTS=sentinel1.casinoos.elite,sentinel2.casinoos.elite,sentinel3.casinoos.elite
SESSION_TTL=3600

# ============================================================
# SOLANA CONFIGURATION
# ============================================================
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
SOLANA_WSS_ENDPOINT=wss://api.mainnet-beta.solana.com
SOLANA_PROGRAM_ID=CASINO_Elite_11111111111111111111111111111111
SOLANA_COMMITMENT=confirmed
SOLANA_MAX_RETRIES=5
SOLANA_ESCROW_PDA_SEED=casinoos-elite-escrow-v1

# Anchor Wallet (Multisig Admin)
SOLANA_ADMIN_WALLETS=["ADMIN1_PUBKEY","ADMIN2_PUBKEY","ADMIN3_PUBKEY","ADMIN4_PUBKEY","ADMIN5_PUBKEY"]
SOLANA_MULTISIG_THRESHOLD=3

# ============================================================
# JWT & AUTHENTICATION
# ============================================================
JWT_SECRET=${JWT_SECRET} # Generate: openssl rand -base64 64
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=casinoos-elite.solana-games.com

# ============================================================
# API SECURITY
# ============================================================
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_SKIP_SUCCESS=false
CORS_ORIGIN=https://casinoos.elite,https://app.casinoos.elite
CORS_CREDENTIALS=true

# Helmet CSP Configuration
CSP_DIRECTIVES="default-src 'self'; script-src 'self' 'unsafe-inline' https://verify.casinoos.elite"

# ============================================================
# JACKPOT CONFIGURATION
# ============================================================
JACKPOT_CONTRIBUTION_RATE=0.02
JACKPOT_GRAND_THRESHOLD=1000
JACKPOT_MAJOR_THRESHOLD=100
JACKPOT_MINOR_THRESHOLD=10
JACKPOT_MINI_THRESHOLD=1
JACKPOT_VAULT_PUBKEY=JACKPOT_VAULT_PUBKEY_HERE

# ============================================================
# RTP & GAME CONFIGURATION
# ============================================================
RTP_TARGET=95
RTP_MIN=90
RTP_MAX=98
MAX_BET_SOL=10
MIN_BET_SOL=0.001
MAX_PAYOUT_MULTIPLIER=500

# ============================================================
# MONITORING & OBSERVABILITY
# ============================================================
DATADOG_API_KEY=${DATADOG_API_KEY}
DATADOG_APP_KEY=${DATADOG_APP_KEY}
SENTRY_DSN=https://${SENTRY_KEY}@sentry.casinoos.elite/1
PAGERDUTY_API_KEY=${PAGERDUTY_API_KEY}
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=90
LOG_TO_CONSOLE=false
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/casinoos-elite

# ============================================================
# COMPLIANCE & REGULATION
# ============================================================
GLI_CERTIFICATE_NUMBER=GLI-2026-1668
MGA_LICENSE_NUMBER=MGA/CRP/1234/2026
GEO_BLOCKED_COUNTRIES=US,UK,AU,FR,NL
SELF_EXCLUSION_DURATION_DAYS=90
DEPOSIT_LIMIT_DAILY=1000
DEPOSIT_LIMIT_WEEKLY=5000
DEPOSIT_LIMIT_MONTHLY=20000
LOSS_LIMIT_DAILY=500

# ============================================================
# INSURANCE & AUDIT (CORRECTED VALUES)
# ============================================================
# 🔧 FIXED: Changed from 50 (SOL) to 50,000,000 (USD)
INSURANCE_POLICY_ID=NXM-2026-CASINO
INSURANCE_COVERAGE_AMOUNT=50000000
AUDIT_LOG_RETENTION_DAYS=2555  # 🔧 FIXED: 7 years (from 255 days)
VERIFICATION_PROOF_STORAGE=solana  # 🔧 FIXED: Changed from '5' to 'solana'
VERIFICATION_HASH_PREFIX=CASINOOS-VERIFY-  # 🔧 FIXED: Changed from 'CAST' to full prefix

# ============================================================
# EMERGENCY CONTACTS (CORRECTED)
# ============================================================
# 🔧 FIXED: Complete multisig public keys array
EMERGENCY_MULTISIG_PUBKEYS=["GUARDIAN1_PUBKEY","GUARDIAN2_PUBKEY","GUARDIAN3_PUBKEY"]
EMERGENCY_PAGERDUTY_SERVICE_ID=ABC123DEF456  # 🔧 FIXED: Complete service ID
INCIDENT_RESPONSE_CHANNEL=casinoos-ir@matrix.casinoos.elite  # 🔧 FIXED: Complete channel

# ============================================================
# DO NOT COMMIT - GENERATED SECRETS
# Generate using: ./scripts/generate-secrets.sh
# ============================================================
